### Example 2: Node.js Microservices with Redis and RabbitMQ

**Project Structure:**
```
microservices/
├── user-service/
│   ├── index.js
│   ├── Dockerfile
│   └── package.json
├── order-service/
│   ├── index.js
│   ├── Dockerfile
│   └── package.json
└── docker-compose.yml
```

**user-service/package.json:**
```json
{
  "name": "user-service",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js"
  },
  "dependencies": {
    "express": "^4.18.0",
    "redis": "^4.6.0",
    "amqplib": "^0.10.0"
  }
}
```

**user-service/index.js:**
```javascript
const express = require('express');
const redis = require('redis');
const amqp = require('amqplib');

const app = express();
app.use(express.json());

const redisClient = redis.createClient({
  host: 'cache',
  port: 6379
});

let channel;

async function connectRabbitMQ() {
  const connection = await amqp.connect('amqp://user:password@queue:5672');
  channel = await connection.createChannel();
  await channel.assertQueue('user_events');
}

app.get('/health', (req, res) => {
  res.json({ status: 'healthy' });
});

app.post('/users', async (req, res) => {
  const { id, name } = req.body;
  
  // Store in Redis
  await redisClient.setEx(`user:${id}`, 3600, JSON.stringify({ id, name }));
  
  // Publish event
  await channel.sendToQueue(
    'user_events',
    Buffer.from(JSON.stringify({ event: 'user_created', id, name }))
  );
  
  res.status(201).json({ id, name });
});

app.get('/users/:id', async (req, res) => {
  const cached = await redisClient.get(`user:${req.params.id}`);
  if (cached) {
    return res.json(JSON.parse(cached));
  }
  res.status(404).json({ error: 'Not found' });
});

connectRabbitMQ().then(() => {
  app.listen(3000, () => {
    console.log('User service running on port 3000');
  });
});
```

**user-service/Dockerfile:**
```dockerfile
FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --only=production

COPY index.js .

USER node

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

EXPOSE 3000

CMD ["npm", "start"]
```

